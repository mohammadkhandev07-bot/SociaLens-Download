{
  "hosting": {
    "public": "out",
    "trailingSlash": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/downloads/**", "headers": [{ "key": "Content-Disposition", "value": "attachment" }] }
    ]
  }
}
